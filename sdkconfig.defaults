# Enable SPIRAM (AtomS3R has 8 MB embedded octal PSRAM)
CONFIG_SPIRAM=y

# Support 2 SNTP servers (for TLS time)
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Use new I2C master driver
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Experimental features (needed by esp_capture)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y

# Keep LWIP/WiFi/mbedTLS off internal RAM where possible (PSRAM has plenty)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Use the built-in full CA bundle for HTTPS/WSS (covers api.vapi.ai and the
# websocket host it hands back)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Certificate verification stays ON. Unlike the Mentes sibling — which ships
# ESP_TLS_INSECURE so a self-signed local dev server works — this firmware only
# ever talks to Vapi's public endpoints, and the API key it sends is a bearer
# credential for the whole account. There is no reason to skip verification and
# a good reason not to.
# CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY is not set
# CONFIG_ESP_TLS_INSECURE is not set

# Force TLS 1.2 for handshake stability on-device
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
# CONFIG_MBEDTLS_SSL_PROTO_TLS1_3 is not set

# Cipher suites (AES-GCM/CCM + ECDHE) — broadly compatible
CONFIG_MBEDTLS_GCM_C=y
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_C=y

# SNTP time sync — with cert verification on, a wrong clock fails every
# handshake, so this is load-bearing rather than cosmetic.
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# Websocket client: give it room for the 4 KB rx buffer plus TLS state.
CONFIG_WS_TRANSPORT=y
